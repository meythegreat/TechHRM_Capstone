APP_NAME=WoSPIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# file avoids 500s when the sessions table is missing (common on first Render boot).
# Use database after the sessions migration has run if you need shared sessions.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Send from the verified fcu-wospis.com domain. Resend rejects @gmail.com From addresses.
MAIL_FROM_ADDRESS="notifications@fcu-wospis.com"
MAIL_FROM_NAME="WoSPIS WSPO"
# Shown in password-reset email footers (can be a real Gmail contact).
MAIL_CONTACT_ADDRESS="wspo.wospis@gmail.com"
RESEND_API_KEY=
# Forgot-password, application-status, and account-security emails use this key.
# On Render, set the same RESEND_API_KEY on the Laravel service.
# MAIL_FROM_ADDRESS must be an address on the verified fcu-wospis.com domain.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional. When empty, the server creates and stores its own phone-notification keys.
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Personal Gmail calendar. Create an OAuth client in Google Cloud and keep the secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1/calendar/google/callback

VITE_APP_NAME="${APP_NAME}"
