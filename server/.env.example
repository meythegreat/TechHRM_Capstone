APP_NAME=WoSPIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# file avoids 500s when the sessions table is missing (common on first Render boot).
# Use database after the sessions migration has run if you need shared sessions.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Resend rejects unverified @gmail.com From addresses. Use onboarding@resend.dev
# until a custom domain is verified in Resend.
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="WoSPIS WSPO"
# Shown in password-reset email footers (can be a real Gmail contact).
MAIL_CONTACT_ADDRESS="miguel102104@gmail.com"
RESEND_API_KEY=
# Forgot-password emails go through this n8n Gmail workflow, not Resend.
# localhost works only when n8n runs on the same machine as Laravel.
# On Render, set the public n8n URL instead.
N8N_FORGOT_PASSWORD_WEBHOOK=http://localhost:5678/webhook/wospis/forgot-password
# Application received / status emails. Uses the same local n8n Gmail account as password reset.
# On Render, set the public n8n URL instead.
N8N_APPLICATION_STATUS_WEBHOOK=http://localhost:5678/webhook/wospis/application-submitted

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional. When empty, the server creates and stores its own phone-notification keys.
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"

# --- Local phone camera testing (Mac + phone on same Wi-Fi) ---
# Phone cannot open http://localhost — that is only the Mac itself.
# Run the Vite client (`cd client && npm run dev`); it binds 0.0.0.0:5173 with
# a self-signed HTTPS cert and prints Phone URLs / a terminal QR.
# Open on the phone: https://<your-lan-ip>:5173  (accept the cert warning).
# Camera / getUserMedia needs a secure context; plain http://LAN never prompts.
# Laravel stays on :8000; Vite proxies /api. CORS already allows private LAN
# https?/http? origins via config/cors.php patterns — still set FRONTEND_URL
# and SANCTUM_STATEFUL_DOMAINS to your current Wi-Fi IP when it changes.
# FRONTEND_URL=https://192.168.x.x:5173
# APP_URL=http://192.168.x.x:8000
# SANCTUM_STATEFUL_DOMAINS=192.168.x.x:5173,192.168.x.x,localhost:5173,localhost,127.0.0.1:5173,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://192.168.x.x:5173,http://localhost:5173,http://127.0.0.1:5173
